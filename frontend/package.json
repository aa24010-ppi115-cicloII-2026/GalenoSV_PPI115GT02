{
  "name": "galenosv-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA de GalenoSV con Web Components y JavaScript est\u00e1ndar",
  "scripts": {
    "start": "browser-sync start --server --files \"index.html, css/*.css, js/**/*.js\" --port 3000 --no-notify --no-open",
    "test": "mocha \"test/**/*.test.js\"",
    "coverage": "c8 --reporter=text --reporter=html mocha \"test/**/*.test.js\""
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "c8": "^12.0.0",
    "chai": "^5.1.2",
    "jsdom": "^29.1.1",
    "mocha": "^11.0.1",
    "sinon": "^19.0.2"
  }
}
